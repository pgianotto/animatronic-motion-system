#!/usr/bin/env python3
"""FPP callback handler for Live Follow plugin.

FPP calls this binary with:
  callbacks --list                  → prints supported event types
  callbacks playlist <name> start   → playlist started
  callbacks playlist <name> stop    → playlist stopped
  callbacks media <title> ...       → media playing (unused)
"""

import sys
import urllib.request
import json

API = 'http://localhost:5001/api/fpp_event'

def post_event(event: str, data: dict = None):
    payload = json.dumps({'event': event, **(data or {})}).encode()
    try:
        req = urllib.request.Request(
            API, data=payload,
            headers={'Content-Type': 'application/json'},
            method='POST',
        )
        urllib.request.urlopen(req, timeout=2)
    except Exception:
        pass  # daemon may not be running — silent fail

if __name__ == '__main__':
    args = sys.argv[1:]

    if not args or args[0] == '--list':
        print('playlist')
        sys.exit(0)

    event_type = args[0]

    if event_type == 'playlist':
        # args: playlist <name> start|stop
        action = args[2] if len(args) >= 3 else ''
        if action == 'start':
            post_event('playlist_start', {'playlist': args[1] if len(args) > 1 else ''})
        elif action == 'stop':
            post_event('playlist_stop',  {'playlist': args[1] if len(args) > 1 else ''})
